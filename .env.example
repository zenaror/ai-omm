# Copie este arquivo para .env para configurar o backup automático.
# O backup começa desligado. Para ativá-lo, preencha as opções e habilite o perfil.
COMPOSE_PROFILES=
## Pasta de dados, separada do código da aplicação. No servidor, use o caminho do volume.
## Use um caminho absoluto para escolher outra pasta do computador.
OMM_DATA_PATH=./omm-data
## 127.0.0.1 limita o serviço a esta máquina; 0.0.0.0 permite acesso pela rede.
OMM_BIND_ADDRESS=127.0.0.1
# Painel simples para ver e organizar a memória (acesso local por padrão).
OMM_WEB_ENABLED=true
## Senha opcional do painel web; ao definir, o navegador pedirá usuário e senha.
## Para acesso pela rede, prefira também HTTPS via proxy reverso.
OMM_WEB_USERNAME=omm
OMM_WEB_PASSWORD=
OMM_GIT_BACKUP_ENABLED=false
## Restaura/atualiza ao iniciar quando houver URL de backup ou remoto origin na pasta de dados.
## Defina false para desligar. O backup agendado continua desligado separadamente.
OMM_GIT_BACKUP_RESTORE=true
OMM_GIT_BACKUP_SCHEDULE=0 3 * * *
OMM_GIT_BACKUP_TIMEZONE=America/Sao_Paulo
OMM_GIT_BACKUP_REMOTE=origin
OMM_GIT_BACKUP_REPOSITORY_URL=
OMM_GIT_BACKUP_BRANCH=main
## false salva commits no Git local; true também envia para o remoto configurado.
OMM_GIT_BACKUP_PUSH=false
OMM_GIT_BACKUP_USERNAME=x-access-token
OMM_GIT_BACKUP_TOKEN=
OMM_GIT_BACKUP_AUTHOR_NAME=OMM Backup
OMM_GIT_BACKUP_AUTHOR_EMAIL=omm@localhost
